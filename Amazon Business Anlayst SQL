write a query to find customer : 

(i) upgraded at least once in their life time 
(ii) downgraded at lease once in their life time 


WITH plan_changes AS (
    SELECT
        customer_id,
        plan_level,
        change_date,
        LAG(plan_level) OVER (
            PARTITION BY customer_id
            ORDER BY change_date
        ) AS previous_plan
    FROM customer_plan_history
)

SELECT
    customer_id
FROM plan_changes
GROUP BY customer_id
HAVING
    -- Customer upgraded at least once
    SUM(CASE
            WHEN plan_level > previous_plan THEN 1
            ELSE 0
        END) > 0

    AND

    -- Customer downgraded at least once
    SUM(CASE
            WHEN plan_level < previous_plan THEN 1
            ELSE 0
        END) > 0;



